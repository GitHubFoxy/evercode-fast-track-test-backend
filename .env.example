# Замените оба значения своими секретами; файл .env не добавляйте в Git.
API_TOKEN=replace-with-a-long-random-service-token
COINMARKETCAP_API_KEY=replace-with-your-coinmarketcap-key

PORT=3000
DATABASE_PATH=./data/evercode.sqlite
PRICE_CURRENCY=USD
CMC_TIMEOUT_MS=10000
# Нижняя граница фонового интервала; фактический интервал зависит от общего бюджета.
# Сервис не запрашивает фоновые котировки чаще документированных 60 секунд.
SYNC_INTERVAL_MS=60000
CMC_BATCH_SIZE=250
SHUTDOWN_TIMEOUT_MS=10000
# По умолчанию официальный Pro API; HTTP разрешён только для локального тестового сервера.
# CMC_BASE_URL=https://pro-api.coinmarketcap.com

# Для первого обращения, включая key/info, необходима проверенная bootstrap-квота.
# Значения получить для своего ключа/тарифа; пустые или выдуманные значения не подходят.
# При неполной квоте внешние запросы запрещены; локальные чтения продолжают работать.
# После перезапуска SQLite-остаток не заменяется исходными значениями окружения.
# CMC_MONTHLY_LIMIT=<проверенный месячный лимит>
# CMC_CREDITS_LEFT=<проверенный остаток кредитов>
# CMC_RESET_AT=<будущий момент сброса ISO 8601 с часовым поясом>
# CMC_RATE_LIMIT_MINUTE=<проверенный минутный лимит запросов>
# CMC_REQUESTS_LEFT=<проверенный остаток запросов текущей UTC-минуты>
# Стоимость key/info не предполагается равной нулю: задать подтверждённую стоимость.
# Без неё используется только явно проверенная конфигурация, без запроса key/info.
# CMC_KEY_INFO_CREDITS=<проверенная стоимость key/info>
