# Замените оба значения своими секретами; файл .env не добавляйте в Git.
API_TOKEN=replace-with-a-long-random-service-token
COINMARKETCAP_API_KEY=replace-with-your-coinmarketcap-key

PORT=3000
DATABASE_PATH=./data/evercode.sqlite
PRICE_CURRENCY=USD
CMC_TIMEOUT_MS=10000
# Нижняя граница фонового интервала; фактический интервал зависит от общего бюджета.
# Сервис не запрашивает фоновые котировки чаще документированных 60 секунд.
SYNC_INTERVAL_MS=60000
CMC_BATCH_SIZE=250
SHUTDOWN_TIMEOUT_MS=10000
# По умолчанию официальный Pro API; HTTP разрешён только для локального тестового сервера.
# CMC_BASE_URL=https://pro-api.coinmarketcap.com

# Необязательный учёт квоты CMC. Без него лимиты применяет сам CoinMarketCap.
# Чтобы сервис распределял запросы по квоте, задайте ВСЕ пять проверенных значений своего тарифа;
# неполный набор считается ошибкой конфигурации, и внешние запросы отклоняются.
# CMC_MONTHLY_LIMIT=<месячный лимит кредитов>
# CMC_CREDITS_LEFT=<остаток кредитов>
# CMC_RESET_AT=<будущий момент сброса, ISO 8601 с часовым поясом>
# CMC_RATE_LIMIT_MINUTE=<лимит запросов в минуту>
# CMC_REQUESTS_LEFT=<остаток запросов текущей минуты>
# Стоимость /v1/key/info; если задана, сервис сверяет остаток с официальным ответом CMC.
# CMC_KEY_INFO_CREDITS=<подтверждённая стоимость key/info>
