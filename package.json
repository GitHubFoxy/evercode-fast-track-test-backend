{
  "name": "evercode-fast-track-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for tracking cryptocurrency prices",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "test": "npm run build && jest --runInBand"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "express": "^5.1.0",
    "swagger-ui-dist": "^5.33.1"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^18.19.0",
    "jest": "29.7.0",
    "supertest": "^7.1.4",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "13.0.3",
    "better-sqlite3-node18": "npm:better-sqlite3@11.10.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "better-sqlite3-node18": true
  },
  "jest": {
    "testMatch": ["<rootDir>/test/**/*.test.cjs"]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
